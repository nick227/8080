{
  "name": "server",
  "version": "0.0.1",
  "description": "Trigger build",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "pnpm --filter @project/db db:push && tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rooms:recount": "tsx src/scripts/recountRooms.ts",
    "record-images:migrate": "tsx src/scripts/migrateRecordImages.ts",
    "bots:seed": "tsx src/scripts/seedBots.ts",
    "email:backfill": "tsx src/scripts/backfillEmailConnections.ts",
    "admin:bootstrap": "tsx --env-file=../../.env src/scripts/bootstrapAdmin.ts",
    "admin:seed": "tsx --env-file=../../.env src/scripts/seedAdminUsers.ts",
    "admin:mfa-reset": "tsx --env-file=../../.env src/scripts/resetStaffMfa.ts",
    "billing:verify-test": "tsx --env-file=../../.env src/scripts/verifyStripeTest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-storage": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@project/db": "workspace:*",
    "@project/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "fastify-openapi-glue": "^4.12.0",
    "fastify-plugin": "^6.0.1",
    "js-yaml": "^5.5.0",
    "livekit-server-sdk": "^2.19.3",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "stripe": "^23.1.0",
    "tsx": "^4.0.0",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "3.6.4",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "smtp-server": "^3.21.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
