{
  "name": "server",
  "version": "0.0.1",
  "description": "Trigger build",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "pnpm --filter @project/db db:push && tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rooms:recount": "tsx src/scripts/recountRooms.ts",
    "record-images:migrate": "tsx src/scripts/migrateRecordImages.ts",
    "bots:seed": "tsx src/scripts/seedBots.ts",
    "email:backfill": "tsx src/scripts/backfillEmailConnections.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@project/db": "workspace:*",
    "@project/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-openapi-glue": "^4.0.0",
    "fastify-plugin": "^6.0.0",
    "js-yaml": "^5.4.3",
    "livekit-server-sdk": "^2.3.0",
    "nodemailer": "^10.0.16",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "smtp-server": "^3.19.17",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
