{
  "name": "server",
  "version": "0.0.1",
  "description": "Trigger build",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "pnpm --filter @project/db db:push && tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rooms:recount": "tsx src/scripts/recountRooms.ts",
    "record-images:migrate": "tsx src/scripts/migrateRecordImages.ts",
    "bots:seed": "tsx src/scripts/seedBots.ts",
    "email:backfill": "tsx src/scripts/backfillEmailConnections.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@project/db": "workspace:*",
    "@project/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.0.0",
    "fastify-openapi-glue": "^4.0.0",
    "fastify-plugin": "^4.0.0",
    "js-yaml": "^4.0.0",
    "livekit-server-sdk": "^2.3.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
