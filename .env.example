# Database
DATABASE_URL=mysql://root:password@localhost:3306/voice_chat_dev

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
# Local testing only: RATE_LIMITS=off disables per-route limits (e.g. 20 guest sessions/hour/IP)
# RATE_LIMITS=off

# Storage — "local" in dev; "s3" for the Railway bucket (S3-compatible) in prod.
# Either way the API serves files at PUBLIC_UPLOAD_BASE_URL (= <api origin>/uploads).
STORAGE_PROVIDER=local
PUBLIC_UPLOAD_BASE_URL=http://localhost:3001/uploads
# UPLOAD_MAX_SIZE_MB=50
# s3 only — on Railway, reference the bucket's variables (S3_BUCKET=${{ bucket.BUCKET }} etc.)
# S3_BUCKET=
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Web
VITE_API_URL=http://localhost:3001
VITE_API_MODE=http
