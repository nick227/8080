# Database
DATABASE_URL=mysql://root:password@localhost:3306/voice_chat_dev

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
# Local testing only: RATE_LIMITS=off disables per-route limits (e.g. 20 guest sessions/hour/IP)
# RATE_LIMITS=off

# Storage — "local" in dev; "s3" for the Railway bucket (S3-compatible) in prod.
# Either way the API serves files at PUBLIC_UPLOAD_BASE_URL (= <api origin>/uploads).
STORAGE_PROVIDER=local
PUBLIC_UPLOAD_BASE_URL=http://localhost:3001/uploads
# UPLOAD_MAX_SIZE_MB=100  (default: MAX_UPLOAD_MB in packages/shared/src/limits.ts)
# s3 only — on Railway, reference the bucket's variables (S3_BUCKET=${{ bucket.BUCKET }} etc.)
# S3_BUCKET=
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Web
VITE_API_URL=http://localhost:3001
VITE_API_MODE=http

# ─── Bots (doc/08) ───────────────────────────────────────────────────────────
# BOTS=off                 # kill switch: bots post nothing (decisions still logged)
# BOTS_DEV=1               # local tuning endpoints under /dev/bots (never in production)
# BOT_TIME_SCALE=1         # multiplies bot waits (0.02 in tests)
# BOT_IDLE_SEC=240         # quiet spell before an idle nudge
# AI — OBSERVATIONAL ONLY (doc/08 §4.9): shadow routing of sampled unmentioned human
# messages; logged, never acted on. Off unless all three are set; never in tests.
# AI_ROUTER=shadow                 # the only mode; anything else = off
# OPENAI_API_KEY=
# OPENAI_ROUTER_MODEL=gpt-4.1-mini
# AI_ROUTER_SAMPLE=1               # share of unmentioned human messages routed (mentions: never)
# AI_ROUTER_ROOM_MAX=30            # calls per room per 10 min
# AI_ROUTER_DAILY_MAX=2000         # calls per day
# AI_ROUTER_DAILY_USD=1            # estimated spend per day (hard stop)
# AI_ROUTER_TIMEOUT_MS=5000        # shadow only; a cold first call can still time out
# AI_PRICE_INPUT_PER_M=0.40        # cost estimate, $/M tokens (gpt-4.1-mini)
# AI_PRICE_OUTPUT_PER_M=1.60
