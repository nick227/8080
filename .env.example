# Database
DATABASE_URL=mysql://root:password@localhost:3306/voice_chat_dev

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
# Local testing only: RATE_LIMITS=off disables per-route limits (e.g. 20 guest sessions/hour/IP)
# RATE_LIMITS=off

# Storage — "local" in dev; "s3" for the Railway bucket (S3-compatible) in prod.
# Either way the API serves files at PUBLIC_UPLOAD_BASE_URL (= <api origin>/uploads).
STORAGE_PROVIDER=local
PUBLIC_UPLOAD_BASE_URL=http://localhost:3001/uploads
# UPLOAD_MAX_SIZE_MB=100  (default: MAX_UPLOAD_MB in packages/shared/src/limits.ts)
# s3 only — on Railway, reference the bucket's variables (S3_BUCKET=${{ bucket.BUCKET }} etc.)
# S3_BUCKET=
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Web
VITE_API_URL=http://localhost:3001
VITE_API_MODE=http

# ─── Bots (doc/08) ───────────────────────────────────────────────────────────
# BOTS=off                 # kill switch: bots post nothing (decisions still logged)
# BOTS_DEV=1               # local tuning endpoints under /dev/bots (never in production)
# BOT_TIME_SCALE=1         # multiplies bot waits (0.02 in tests)
# BOT_IDLE_SEC=240         # quiet spell before an idle nudge
# Phase 2 slice 1 — AI router in shadow mode (logs only, never changes behaviour).
# Off unless all three are set:
# AI_ROUTER=shadow
# OPENAI_API_KEY=
# OPENAI_ROUTER_MODEL=     # a small, fast chat model with JSON-schema structured output
# AI_ROUTER_SAMPLE=1               # share of UNMENTIONED human messages routed (the cases the router is for)
# AI_ROUTER_MENTION_SAMPLE=0.1     # explicit mentions: a control sample only (deterministic owns them)
# AI_ROUTER_ROOM_MAX=30            # router calls per room per 10 min
# AI_ROUTER_DAILY_MAX=2000
# AI_ROUTER_SHADOW_TIMEOUT_MS=5000 # shadow blocks nothing; a cold first call (~5.3s) can still time out
# AI_ROUTER_LIVE_TIMEOUT_MS=2000   # slice 2 live path — separate on purpose, then deterministic fallback
