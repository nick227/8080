generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Identity ────────────────────────────────────────────────────────────────
// Guest-first: POST /auth/guest creates a User with no email/password.
// POST /auth/register upgrades the current guest in place (keeps history).

// human = a person (guest or registered). bot = a house/optional chatbot: a real
// user that posts through the normal services, never logs in (doc/08 I1, I7).
enum UserKind {
  human
  bot
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  passwordHash String?
  googleSub    String?   @unique @db.VarChar(191)
  isGuest      Boolean   @default(true)
  kind         UserKind  @default(human)
  suspendedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  profile     Profile?
  sessions    Session[]
  ownedRooms  Room[]       @relation("RoomOwner")
  memberships RoomMember[]
  messages    Message[]
  media       Media[]
  reactions   Reaction[]
  bot         Bot?
  mutes       UserMute[]   @relation("Muter")
  mutedBy     UserMute[]   @relation("Muted")

  workspacesCreated Workspace[]       @relation("WorkspaceCreator")
  workspaceMembers  WorkspaceMember[]

  @@index([kind])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String   @db.VarChar(50)
  avatarUrl   String?  @db.VarChar(512)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Rooms ───────────────────────────────────────────────────────────────────

enum RoomVisibility {
  public
  private
}

enum RoomRole {
  owner
  member
}

model Room {
  taskLinks      TaskLink[]
  documentLinks DocumentRoomLink[]

  id             String         @id @default(cuid())
  // Human-facing sequence shown as "CONVERSATION 018"
  number         Int            @unique @default(autoincrement())
  title          String         @db.VarChar(120)
  description    String?        @db.Text
  thumbnailId    String?
  topic          String?        @db.VarChar(40)
  visibility     RoomVisibility @default(public)
  // Private rooms only; rotatable via POST /rooms/{roomId}/invite-code
  inviteCode     String?        @unique @db.VarChar(32)
  ownerId        String
  // Per-room item sequence counter; incremented in the createItem transaction
  changeCount    Int            @default(0)
  changes        RoomChange[]
  itemCount      Int            @default(0)
  responseCount  Int            @default(0)
  durationMs     Int            @default(0)
  // Lobby sort key; bumped on every new item. Non-null so it can anchor cursors.
  lastActivityAt DateTime       @default(now())
  lastResponseAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  owner     User         @relation("RoomOwner", fields: [ownerId], references: [id])
  thumbnail Media?       @relation("RoomThumbnail", fields: [thumbnailId], references: [id])
  members   RoomMember[]
  items     Item[]
  bots      RoomBot[]
  links      RecordLink[]
  activities Activity[]
  workspaceChannel WorkspaceChannel?
  companyLink      WorkspaceRoom?

  @@index([visibility, lastActivityAt, id])
  @@index([topic])
  @@index([ownerId])
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     RoomRole @default(member)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

// ─── Conversation graph ──────────────────────────────────────────────────────
// Store facts, derive relationships: only parentId is persisted. Branches are
// computed client-side (utils/graph.ts). Deletes are tombstones so replies
// never lose their parent.

model Message {
  id        String    @id @default(cuid())
  authorId  String
  text      String?   @db.Text
  // Bot-offered choice (doc/12 §4): { flow, step, mode, options, forUserId }. Set only
  // by server code (never from HTTP) and only on bot-authored messages.
  actions   Json?
  // The one answer to `actions`: { optionIds, userId, at }. First choice wins.
  choice    Json?
  // The registered workflow that posted this (doc/12). Workflow posts have their own
  // bounded allowance and are left out of the ordinary bot caps.
  workflow  String?   @db.VarChar(64)
  // Things this bot message points at (doc/12 §5.4): [{ type: 'document', id, workspaceId, title }].
  // Set only by server code.
  links     Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author User    @relation(fields: [authorId], references: [id])
  media  Media[]
  items  Item[]
  note   Note?

  @@index([authorId])
}

model Item {
  id            String    @id @default(cuid())
  roomId        String
  messageId     String
  // Per-room sequence → "RE:003"
  number        Int
  parentId      String?
  // Moment (ms) in the parent's single audio/video attachment this reply responds
  // to — a point, not a range. Placement-level: the same Message shared into another
  // room has its own, independent anchors (none are copied).
  anchorStartMs Int?
  // Room chat, not a stage broadcast. Share and replies do not copy it.
  chat          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message   Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  parent    Item?      @relation("ItemReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Item[]     @relation("ItemReplies")
  reactions Reaction[]
  links      RecordLink[]
  proposals  AgentProposal[]
  activities Activity[]
  activityEvents ActivityEvent[]

  @@unique([roomId, number])
  @@index([parentId])
  @@index([parentId, anchorStartMs]) // markers for a parent, in timeline order
  @@index([messageId])
  @@index([roomId, createdAt, id])
  @@index([parentId, deletedAt, createdAt, id]) // River: newest live top-level items, keyset order
}

// Where the media lives. stored = our upload/capture (file under storageKey);
// youtube = external video referenced by canonical id (never downloaded).
enum MediaSource {
  stored
  youtube
}

enum MediaKind {
  audio
  video
  image
  file
}

// Uploaded first (messageId null), then attached when the message is created.
// Public URLs are derived from storageKey at serialize time (provider-specific),
// never stored — cloud buckets may need signed or re-based URLs.
// ## Phase 2: sweep unattached media older than N hours.
model Media {
  id         String      @id @default(cuid())
  ownerId    String
  messageId  String?
  kind       MediaKind
  source     MediaSource @default(stored)
  storageKey String?     @unique @db.VarChar(255) // null for external (youtube)
  externalId String?     @db.VarChar(32) // canonical YouTube video id
  title      String?     @db.VarChar(300)
  embeddable Boolean     @default(true)
  mimeType   String      @db.VarChar(127)
  size       Int
  // Seconds, for audio/video
  duration   Float?
  name       String?     @db.VarChar(255)
  posterUrl  String?     @db.VarChar(512)
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  owner   User     @relation(fields: [ownerId], references: [id])
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  roomsAsThumbnail Room[] @relation("RoomThumbnail")
  recordImages RecordImage[]

  @@index([messageId, position])
  @@index([ownerId, createdAt])
}

enum ReactionType {
  like
  ack
  laugh
}

model Reaction {
  id        String       @id @default(cuid())
  itemId    String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId, type])
  @@index([userId])
}

// ─── Bots (doc/08) ───────────────────────────────────────────────────────────
// A bot's content and behaviour come from its pack (apps/server/bots/<handle>/),
// loaded into these tables by the idempotent seed. Seating authorizes a bot to act
// in a room; bots never get RoomMember rows (I1).

enum BotKind {
  house    // seated in every room unless kicked
  optional // seated only when the owner adds it
}

model Bot {
  id          String   @id @default(cuid())
  userId      String   @unique
  handle      String   @unique @db.VarChar(40)
  kind        BotKind
  persona     String?  @db.Text
  enabled     Boolean  @default(true)
  packVersion String   @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rooms     RoomBot[]
  lines     BotLine[]
  assets    BotAsset[]
  decisions BotDecision[]
  onces     BotOnce[]
}

enum BotSeat {
  seated
  kicked
}

// No row = the bot's default (house → seated, optional → not seated).
model RoomBot {
  id        String   @id @default(cuid())
  roomId    String
  botId     String
  state     BotSeat
  addedById String?
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bot  Bot  @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([roomId, botId])
  @@index([botId])
}

// One statement in a pack. Text lines create a fresh Message on every use.
model BotLine {
  id          String   @id @default(cuid())
  botId       String
  key         String   @db.VarChar(80) // stable id within the pack
  pool        String   @db.VarChar(40)
  intents     Json     // string[]
  tags        Json     // string[]
  text        String   @db.Text // may contain {slots}
  assetKey    String?  @db.VarChar(80)
  weight      Float    @default(1)
  cooldownSec Int      @default(0)
  minGapSec   Int      @default(0)
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, key])
  @@index([botId, pool])
}

// Library media: a bot-authored Message uploaded once. Each staging places a new
// Item for it (I2) — the asset itself is never placed.
model BotAsset {
  id          String   @id @default(cuid())
  botId       String
  key         String   @db.VarChar(80)
  messageId   String
  intents     Json
  tags        Json
  weight      Float    @default(1)
  cooldownSec Int      @default(0)
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, key])
}

// Every run's outcome, posted or skipped, with the scored candidates so an exact
// replay reproduces the choice (doc/08 §4.4). Cooldowns read this; pruning keeps
// at least BOT_DECISION_RETENTION_DAYS (≥ the longest cooldown).
model BotDecision {
  id                String   @id @default(cuid())
  botId             String
  roomId            String
  workflow          String   @db.VarChar(40)
  runKey            String   @db.VarChar(120)
  trigger           Json
  subjects          Json     // userIds this run was about (greet cooldown)
  packVersion       String   @db.VarChar(64)
  classifierVersion String?  @db.VarChar(40)
  inputs            Json
  candidates        Json     // [{ id, score, factors }]
  filtered          Json     // [{ id, reason }]
  rngSeed           String?  @db.VarChar(64)
  draw              Float?
  chosen            String?  @db.VarChar(80)
  skippedReason     String?  @db.VarChar(60)
  itemId            String?
  at                DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, roomId, workflow, at])
  @@index([roomId, at])
  @@index([at])
}

enum BotOnceOutcome {
  posted
  skipped
}

// Once-ever keys (e.g. opening:{roomId}). Claimed in the same transaction that
// places the Item, so it survives restarts and is race-safe (doc/08 §4.3).
model BotOnce {
  id      String         @id @default(cuid())
  botId   String
  roomId  String
  key     String         @db.VarChar(120)
  outcome BotOnceOutcome
  reason  String?        @db.VarChar(60)
  itemId  String?
  at      DateTime       @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, roomId, key])
}

// Personal, global mute (doc/08 I5). Enforced at serialization and SSE.
model UserMute {
  id          String   @id @default(cuid())
  userId      String
  mutedUserId String
  createdAt   DateTime @default(now())

  user  User @relation("Muter", fields: [userId], references: [id], onDelete: Cascade)
  muted User @relation("Muted", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId])
  @@index([mutedUserId])
}

// Content-free durable journal: replay hydrates current state, including tombstones.
model RoomChange {
  roomId String
  sequence Int
  itemId String
  actorId String
  type String @db.VarChar(32)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@id([roomId, sequence])
}

// Phase 2 slice 1 (doc/08): the AI router's choice logged next to the deterministic
// routing for the same message. Shadow mode — it never changes behaviour.
model BotRoute {
  id            String   @id @default(cuid())
  roomId        String
  itemId        String
  mode          String   @db.VarChar(16) // shadow (the only mode — AI is observational, doc/08 §4.9)
  trigger       String   @db.VarChar(32) // what caused the request: item.created (human)
  provider      String   @db.VarChar(32)
  model         String?  @db.VarChar(80)
  reason        String   @db.VarChar(24) // mentioned (control sample) | unmentioned
  cold          Boolean  @default(false) // first call of this process — excluded from warm latency
  input         Json     // compact, truncated context actually sent
  deterministic Json     // { agent, shouldRespond, intents }
  ai            Json?    // { agent, intent, confidence, shouldRespond }
  error         String?  @db.VarChar(120)
  agree         Boolean?
  latencyMs     Int?
  inputChars    Int      @default(0) // size of what was sent
  promptTokens     Int?
  completionTokens Int?
  costUsd       Float?   // estimate from AI_PRICE_*_PER_M; summed for the daily budget
  // Human ground truth (dev labeling): { agent, shouldRespond } — what should have happened.
  label         Json?
  labeledAt     DateTime?
  at            DateTime @default(now())

  @@index([roomId, at])
  @@index([at])
}

// ─── Workspace (doc/09) ──────────────────────────────────────────────────────
// Business data (contacts, deals, inbox, calendar, tasks) belongs to a Workspace,
// never to a Room: conversations link to it, they don't own it. Every
// workspace-scoped row carries workspaceId; services keep cross-references inside
// one workspace and an invariant test checks it (services/workspaceIntegrity.ts).
// Permissions are decided only in services/workspacePolicy.ts.

enum WorkspaceRole {
  owner
  admin
  member
}

// Invitations live in WorkspaceInvite, so a member row starts at acceptance.
// Rows are never deleted (removed keeps history and ownership resolvable).
enum MemberStatus {
  active
  suspended
  removed
}

enum TeamRole {
  lead
  member
}

model Workspace {
  taskLinks        TaskLink[]
  taskViews        TaskView[]
  documents Document[]
  documentGrants DocumentGrant[]
  documentRoomLinks DocumentRoomLink[]
  documentRelations DocumentRelation[]

  id              String    @id @default(cuid())
  name            String    @db.VarChar(120)
  slug            String    @unique @db.VarChar(60)
  timezone        String    @default("UTC") @db.VarChar(64)
  defaultCurrency String    @default("USD") @db.Char(3)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  createdBy        User              @relation("WorkspaceCreator", fields: [createdById], references: [id])
  members          WorkspaceMember[]
  invites          WorkspaceInvite[]
  teams            Team[]
  teamMembers      TeamMember[]
  actions          ActionExecution[]
  activities       Activity[]
  activitySubjects ActivitySubject[]
  conversations    WorkspaceRoom[]
  businessEvents AgentBusinessEvent[]
  emailSuppressions AgentEmailSuppression[]
  unsubscribeTokens AgentUnsubscribeToken[]
  contactFieldDefinitions ContactFieldDefinition[]
  pipelineStages   PipelineStage[]
  inventoryCategories InventoryCategory[]
  contacts         Contact[]
  contactPoints    ContactPoint[]
  accounts         Account[]
  contactAccounts  ContactAccount[]
  tags             Tag[]
  contactTags      ContactTag[]
  accountTags      AccountTag[]
  notes            Note[]
  links            RecordLink[]
  imports          ImportBatch[]
  importRows       ImportRow[]
  documentContents DocumentContent[]
  inboxItems       InboxItem[]
  activityEvents   ActivityEvent[]
  composes         Compose[]
  inventories      Inventory[]
  interests        Interest[]
  stockMovements   InventoryStockMovement[]
  recordImages     RecordImage[]
  channel          WorkspaceChannel?
  workflowRuns     WorkflowRun[]
  companyProfile   CompanyProfile?
  companyFacts     CompanyFact[]
  companySources   CompanyScalarSource[]
  companyRevisions CompanyProfileRevision[]
  assistantCalls   AssistantCall[]
  proposals        AgentProposal[]
  contactBriefs    ContactBrief[]
  emailConnections EmailConnection[]
  agents           Agent[]
  sprints          Sprint[]
  workTasks        WorkTask[]
  workLogs         WorkLog[]
  taskBoard        TaskBoardSettings?
  taskStatuses     TaskStatusDef[]

  @@index([createdById])
}

// Membership requires a registered human account (doc/09 D8, D11).
model WorkspaceMember {
  taskLinksMade  TaskLink[]
  ownedDocuments Document[]
  documentGrants DocumentGrant[]

  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  status      MemberStatus  @default(active)
  title       String?       @db.VarChar(120)
  timezone    String?       @db.VarChar(64)
  // Task notifications by email: off | direct (mentions + assignments) | all
  taskEmail   String        @default("direct") @db.VarChar(16)
  // The WorkspaceMember who invited them (no FK: history only)
  invitedById String?       @db.VarChar(64)
  joinedAt    DateTime      @default(now())
  removedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams       TeamMember[]
  invitesSent WorkspaceInvite[]
  actions     ActionExecution[]
  activities  Activity[]
  ownedContacts   Contact[]    @relation("ContactOwner")
  createdContacts Contact[]    @relation("ContactCreator")
  ownedAccounts   Account[]    @relation("AccountOwner")
  createdAccounts Account[]    @relation("AccountCreator")
  notes           Note[]
  linksMade       RecordLink[]
  imports         ImportBatch[]
  documentEdits   DocumentContent[]
  inboxItems      InboxItem[]
  activityEvents  ActivityEvent[]
  composes        Compose[]
  workflowRuns    WorkflowRun[]
  companyFacts    CompanyFact[]
  stockMovements  InventoryStockMovement[]
  companySources  CompanyScalarSource[]
  proposalsMade    AgentProposal[] @relation("ProposalCreator")
  contactBriefs    ContactBrief[]
  proposalsDecided AgentProposal[] @relation("ProposalDecider")
  assignedWorkTasks WorkTask[] @relation("WorkTaskAssignee")
  createdWorkTasks  WorkTask[] @relation("WorkTaskCreator")
  blockedWorkTasks  WorkTask[] @relation("WorkTaskBlocker")
  checkedItems      WorkChecklistItem[] @relation("ChecklistDoneBy")
  workComments      WorkComment[]
  workLogs          WorkLog[] @relation("WorkLogAuthor")
  workLogsDone      WorkLog[] @relation("WorkLogMember")
  taskViews         TaskView[]

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
}

// The token is shown once at creation; only its SHA-256 is stored.
model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String        @db.VarChar(254) // normalised (trimmed, lower-case)
  role        WorkspaceRole
  tokenHash   String        @unique @db.Char(64)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy WorkspaceMember @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([invitedById])
}

// Routing/visibility groups (a queue a record can belong to), not an org chart.
model Team {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    @db.VarChar(80)
  description String?   @db.VarChar(500)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  contacts  Contact[]
  accounts  Account[]

  @@unique([workspaceId, name])
}

model TeamMember {
  id          String   @id @default(cuid())
  teamId      String
  workspaceId String
  memberId    String
  role        TeamRole @default(member)
  createdAt   DateTime @default(now())

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
  @@index([workspaceId])
}

// ─── Audit and timeline (doc/09 §3) ──────────────────────────────────────────

// `agent` is deliberately not a value: AI is observational only until the agent
// action model and permission system exist (doc/08 §4.9).
enum ActorKind {
  member
  system
  integration
}

enum ActionOrigin {
  ui
  api
  import
  sync
  system
  assistant // a registered chatbot workflow acting for the member who answered (doc/12 §2)
}

enum ActionStatus {
  pending
  succeeded
  failed
  rejected
}

// One row per workspace command, written in the same transaction as the change
// (services/actions.ts). The audit log and the idempotency record. Target is a
// plain type/id pair on purpose: audit outlives the rows it describes.
model ActionExecution {
  id             String       @id @default(cuid())
  workspaceId    String
  action         String       @db.VarChar(64) // "member.update", "team.create" …
  actorKind      ActorKind
  actorMemberId  String?
  actorUserId    String?      @db.VarChar(64) // kept even after the member is removed (no FK)
  origin         ActionOrigin
  // Only succeeded (or pending) executions hold their key, so a rejected attempt can be retried.
  idempotencyKey String?      @db.VarChar(120)
  status         ActionStatus
  targetType     String?      @db.VarChar(32)
  targetId       String?      @db.VarChar(64)
  input          Json
  changes        Json? // { field: [before, after] }
  result         Json?
  errorCode      String?      @db.VarChar(60)
  requestedAt    DateTime     @default(now())
  finishedAt     DateTime?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorMember WorkspaceMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, requestedAt, id])
  @@index([workspaceId, targetType, targetId, requestedAt])
  @@index([actorMemberId])
}

// The people-facing timeline: business events, append-only. `summary` is a
// display snapshot, never read by logic. Object arc — what the event refers to, at
// most one of: noteId, roomId (+ itemId). inboxMessageId, taskId, eventId,
// dealStageChangeId arrive with their domains.
model Activity {
  id                String   @id @default(cuid())
  workspaceId       String
  type              String   @db.VarChar(48) // "member.joined", "team.created" …
  occurredAt        DateTime
  recordedAt        DateTime @default(now())
  actorMemberId     String?
  actionExecutionId String?
  noteId            String?
  roomId            String?
  itemId            String?
  // The task this event is about (Calendar/Boards): its history is these rows.
  taskId            String?
  summary           Json

  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorMember     WorkspaceMember?  @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  actionExecution ActionExecution?  @relation(fields: [actionExecutionId], references: [id], onDelete: SetNull)
  note            Note?             @relation(fields: [noteId], references: [id], onDelete: SetNull)
  room            Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  item            Item?             @relation(fields: [itemId], references: [id], onDelete: SetNull)
  task            WorkTask?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  subjects        ActivitySubject[]

  @@index([workspaceId, occurredAt, id])
  @@index([actorMemberId])
  @@index([actionExecutionId])
  @@index([noteId])
  @@index([roomId])
  @@index([itemId])
  @@index([taskId, occurredAt])
}

// Which records an activity is about: one row per subject, so one email about a
// contact, an account and a deal shows on all three timelines. Subject arc: exactly
// one of contactId | accountId (leadId, dealId arrive with Sales); subjectKey
// ("contact:<id>") keeps one row per subject. Linking an object to a subject adds
// the subject to that object's activities; unlinking removes it (doc/09 Q-B).
model ActivitySubject {
  id          String   @id @default(cuid())
  activityId  String
  workspaceId String
  subjectKey  String   @db.VarChar(80)
  contactId   String?
  accountId   String?
  inventoryId String?
  occurredAt  DateTime // copied from the activity → timeline index without a join

  activity  Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inventory Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([activityId, subjectKey])
  @@index([workspaceId])
  @@index([contactId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([inventoryId, occurredAt])
}

// ─── Contacts (doc/09 §4.1, slice 1) ─────────────────────────────────────────
// First-class records owned by the workspace. Email is a match signal, never a
// unique key (D2): services/contactMatch.ts decides matches; duplicates are
// resolved by merge. Soft delete + merge, never hard delete.

enum RecordStatus {
  active
  archived
}

// How the row was created (not why the person showed up — that's leadSource).
enum RecordOrigin {
  manual
  import
  inbox
  calendar
  conversation
  api
  sync
}

enum ContactPointKind {
  email
  phone
  url
  social
}

enum AccountType {
  prospect
  customer
  partner
  vendor
  other
}

enum LinkOrigin {
  manual
  auto_match
  import
  system
}

model Contact {
  taskLinks      TaskLink[]
  version Int @default(1)
  id               String       @id @default(cuid())
  workspaceId      String
  firstName        String?      @db.VarChar(80)
  lastName         String?      @db.VarChar(80)
  // Given, or derived from the name / primary email / phone when blank
  displayName      String       @db.VarChar(160)
  title            String?      @db.VarChar(120)
  status           RecordStatus @default(active)
  ownerMemberId    String?
  teamId           String?
  // Derived from ContactPoint (recomputed whenever points change)
  primaryEmail     String?      @db.VarChar(255)
  primaryPhone     String?      @db.VarChar(40)
  // Derived: newest activity this contact is a subject of
  lastActivityAt   DateTime?
  origin           RecordOrigin @default(manual)
  externalProvider String?      @db.VarChar(32)
  externalId       String?      @db.VarChar(255)
  // The canonical import that created it (doc/10 §7A step 6)
  importBatchId    String?
  createdById      String?
  // Set on the losing contact of a merge; its URL resolves to the winner
  mergedIntoId     String?
  // Sales pipeline stage key → PipelineStage.key (distinct from RecordStatus).
  leadStatus       String       @default("contacted") @db.VarChar(64)
  leadSource       String?      @db.VarChar(80)
  nextFollowUp     DateTime?
  // Sales workbench: milestones are independent of the current lead stage.
  contacted        Boolean @default(false)
  qualified        Boolean @default(false)
  proposalSent     Boolean @default(false)
  won              Boolean @default(false)
  nextAction       String? @db.VarChar(255)
  interestedIn     String? @db.VarChar(255)
  lastContactedAt  DateTime?
  priority         String @default("normal") @db.VarChar(40)
  waitingOn        String? @db.VarChar(40)
  potentialValue   Decimal? @db.Decimal(15, 2)
  fieldValues      Json?
  // Denormalized primary gallery projection — written only by RecordImageService.
  imageUrl         String?      @db.VarChar(512)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerMember WorkspaceMember? @relation("ContactOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  team        Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   WorkspaceMember? @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  mergedInto  Contact?         @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  mergedFrom  Contact[]        @relation("ContactMerge")
  importBatch ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importRows  ImportRow[]
  points      ContactPoint[]
  briefs      ContactBrief[]
  accounts    ContactAccount[]
  tags        ContactTag[]
  links       RecordLink[]
  subjects    ActivitySubject[]
  composes    Compose[]
  interests   Interest[]
  businessEvents AgentBusinessEvent[]

  @@unique([workspaceId, externalProvider, externalId])
  @@index([workspaceId, displayName, id])
  @@index([workspaceId, ownerMemberId])
  @@index([workspaceId, lastActivityAt])
  @@index([mergedIntoId])
  @@index([importBatchId])
}

// Named inventory categories for the Company vocabulary (items still store category as text).
model InventoryCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String   @db.VarChar(80)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, name])
}

// Workspace sales pipeline. Seeded from DEFAULT_PIPELINE_STAGES; Company vocabulary edits these.
model PipelineStage {
  id          String  @id @default(cuid())
  workspaceId String
  key         String  @db.VarChar(64)
  label       String  @db.VarChar(80)
  position    Int     @default(0)
  kind        String  @db.VarChar(16) // open | won | lost
  archived    Boolean @default(false)
  system      Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
}

// Stable workspace-scoped definitions for the Company vocabulary / Contacts workbench.
// Built-in IDs map to typed Contact columns; custom IDs map into fieldValues.
model ContactFieldDefinition {
  id String @id @default(cuid())
  workspaceId String
  key String @db.VarChar(64)
  label String @db.VarChar(80)
  type String @db.VarChar(16)
  numberConfig Json?
  options Json?
  position Int @default(0)
  archived Boolean @default(false)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// What the workspace sells. Soft-archive via status; hard-delete is admin-only.
model Inventory {
  id                String       @id @default(cuid())
  workspaceId       String
  name              String       @db.VarChar(160)
  sku               String?      @db.VarChar(80)
  description       String?      @db.Text
  // The price, exactly: integer minor units (cents) in `currency` (doc/13 A4).
  priceMinor        Int          @default(0)
  currency          String       @default("USD") @db.Char(3)
  category          String?      @db.VarChar(80)
  status            RecordStatus @default(active)
  quantity          Int? // null = service / catalog entry with no stock count
  // Alert when tracked quantity is above zero and at or below this level (null = no low-stock view).
  lowStockThreshold Int?
  // Maintained on write: tracked, threshold set, 0 < quantity <= threshold.
  lowStock          Boolean      @default(false)
  location          String?      @db.VarChar(120)
  availability      Boolean      @default(true)
  // Denormalized primary gallery projection — written only by RecordImageService.
  imageUrl          String?      @db.VarChar(512)
  // Optimistic concurrency: an update names the version it read and is refused (409)
  // if the item changed since. Also the stale check for agent proposals (doc/13 §5).
  version           Int          @default(1)
  importBatchId     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  importBatch    ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  interests      Interest[]
  importRows     ImportRow[]
  stockMovements InventoryStockMovement[]
  links          RecordLink[]
  subjects       ActivitySubject[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, name])
  @@index([importBatchId])
  @@index([workspaceId, lowStock])
  @@index([workspaceId, priceMinor])
}

// Ordered gallery for a contact or inventory item. Media holds bytes/playback;
// parent imageUrl is the denormalized primary projection (RecordImageService only).
enum RecordImageSubject {
  contact
  inventory
  company
}

model RecordImage {
  id          String             @id @default(cuid())
  workspaceId String
  subjectType RecordImageSubject
  subjectId   String             @db.VarChar(64)
  mediaId     String
  sortOrder   Int                @default(0)
  isPrimary   Boolean            @default(false)
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  media     Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, subjectType, subjectId, mediaId])
  @@index([workspaceId, subjectType, subjectId, sortOrder])
  @@index([workspaceId, subjectType, subjectId, isPrimary])
  @@index([mediaId])
}

// Append-only quantity changes (adjust / edit / import). Not a full warehouse ledger.
model InventoryStockMovement {
  id            String   @id @default(cuid())
  workspaceId   String
  inventoryId   String
  fromQuantity  Int?
  toQuantity    Int?
  delta         Int?
  reason        String?  @db.VarChar(240)
  source        String   @db.VarChar(16) // adjust | edit | import
  actorMemberId String?
  createdAt     DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inventory Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor     WorkspaceMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, inventoryId, createdAt])
  @@index([actorMemberId])
}

// A contact's interest in one inventory item (idempotent per contact+item).
model Interest {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  inventoryId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, contactId, inventoryId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, inventoryId])
}

model ContactPoint {
  id          String           @id @default(cuid())
  workspaceId String
  contactId   String
  kind        ContactPointKind
  value       String           @db.VarChar(255)
  normalized  String           @db.VarChar(255)
  label       String?          @db.VarChar(40)
  isPrimary   Boolean          @default(false)
  // Role/shared address (info@, sales@, a household inbox): never auto-matched
  shared      Boolean          @default(false)
  // Derived: false once the contact is deleted or merged (keeps the match index tight)
  live        Boolean          @default(true)
  position    Int              @default(0)
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, normalized, live]) // match lookups — deliberately NOT unique (D2)
  @@index([contactId, position])
}

model Account {
  id               String       @id @default(cuid())
  workspaceId      String
  name             String       @db.VarChar(160)
  domain           String?      @db.VarChar(255)
  // Normalised domain; a match signal, not unique (subsidiaries share domains)
  domainKey        String?      @db.VarChar(255)
  website          String?      @db.VarChar(255)
  industry         String?      @db.VarChar(80)
  sizeBand         String?      @db.VarChar(16)
  type             AccountType  @default(prospect)
  status           RecordStatus @default(active)
  parentAccountId  String?
  ownerMemberId    String?
  teamId           String?
  lastActivityAt   DateTime?
  origin           RecordOrigin @default(manual)
  externalProvider String?      @db.VarChar(32)
  externalId       String?      @db.VarChar(255)
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerMember   WorkspaceMember? @relation("AccountOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  team          Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy     WorkspaceMember? @relation("AccountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parentAccount Account?         @relation("AccountParent", fields: [parentAccountId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  childAccounts Account[]        @relation("AccountParent")
  contacts      ContactAccount[]
  tags          AccountTag[]
  links         RecordLink[]
  subjects      ActivitySubject[]

  @@unique([workspaceId, externalProvider, externalId])
  @@index([workspaceId, domainKey])
  @@index([workspaceId, name, id])
  @@index([workspaceId, ownerMemberId])
  @@index([parentAccountId])
}

// People change jobs: endedAt keeps the history. At most one live primary per contact (service rule).
model ContactAccount {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String
  accountId   String
  role        String?   @db.VarChar(80)
  isPrimary   Boolean   @default(false)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([contactId, accountId])
  @@index([accountId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String   @db.VarChar(40)
  color       String?  @db.VarChar(16)
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts  ContactTag[]
  accounts  AccountTag[]

  @@unique([workspaceId, name])
}

// Per-domain tag joins keep real FKs (no polymorphic tag table).
model ContactTag {
  tagId       String
  contactId   String
  workspaceId String

  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([tagId, contactId])
  @@index([contactId])
  @@index([workspaceId])
}

model AccountTag {
  tagId       String
  accountId   String
  workspaceId String

  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([tagId, accountId])
  @@index([accountId])
  @@index([workspaceId])
}

// ─── Shared: notes and links (doc/09 §3) ─────────────────────────────────────

// The body is a Message (+ Media), so voice/video notes record and play like any
// capture. No Item until the author shares it into a room (D10). Deleting a note
// never removes its room placements; deleting the capture in a room purges it
// everywhere, the note included (purgeCapture).
model Note {
  id             String    @id @default(cuid())
  workspaceId    String
  messageId      String    @unique
  authorMemberId String
  // What the agent read from the note, each with the note's own words (doc/13 §10):
  // [{ key: need|timing|budget|other, value, quote }]. The note text stays verbatim.
  facts          Json?
  pinnedAt       DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message      Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  authorMember WorkspaceMember @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  links        RecordLink[]
  activities   Activity[]

  @@index([workspaceId, createdAt])
  @@index([authorMemberId])
}

// Many-to-many "related to" between a subject and an object. Subject arc (exactly
// one): contactId | accountId (leadId, dealId with Sales). Object arc (exactly
// one): noteId | roomId (+ itemId for one moment in it) — threadId, taskId,
// eventId with their domains. pairKey makes each pair unique without nullable
// composite uniques. Conversations are linked, never owners (§6).
model RecordLink {
  id          String     @id @default(cuid())
  workspaceId String
  contactId   String?
  accountId   String?
  inventoryId String?
  noteId      String?
  roomId      String?
  itemId      String?
  pairKey     String     @db.VarChar(80) // "contact:<id>|item:<id>"
  how         LinkOrigin @default(manual)
  linkedById  String?
  createdAt   DateTime   @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  account   Account?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inventory Inventory?       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  note      Note?            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  item      Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  linkedBy  WorkspaceMember? @relation(fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, pairKey])
  @@index([contactId])
  @@index([accountId])
  @@index([inventoryId])
  @@index([noteId])
  @@index([roomId])
  @@index([itemId])
  @@index([linkedById])
}

// Documents v1: validated descriptor union is the public contract. Native payloads
// are absent until an editor schema lands; grid materializations use GridTable v1.
enum DocumentSurface {
  blocks
  mental_map
  grid
  external
}
enum DocumentSourceKind {
  native
  dataset
  external
}
enum DocumentGrantRole {
  viewer
  editor
}
model Document {
  id String @id @default(cuid())
  workspaceId String
  ownerMemberId String
  title String @db.VarChar(200)
  surface DocumentSurface
  sourceKind DocumentSourceKind
  descriptor Json
  version Int @default(1)
  // Only CSV imports/review copies have a payload in this backend slice.
  payload Json?
  provenance Json?
  // Source protection survives conversion to an independent review copy.
  protectedDataset String? @db.VarChar(64)
  // Google file id extracted from an external link: warns about duplicate links
  // in the workspace without merging entries or their access (doc/10 §3).
  externalFileId String? @db.VarChar(128)
  // Audience beyond the owner and per-member grants: null = private (a person's own
  // document); viewer/editor = every active member of the workspace (a workspace
  // workflow's document, e.g. the company description — doc/12 §5.4).
  workspaceAccess DocumentGrantRole?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner WorkspaceMember @relation(fields: [ownerMemberId], references: [id])
  grants DocumentGrant[]
  rooms DocumentRoomLink[]
  relationsFrom DocumentRelation[] @relation("DocumentRelationFrom")
  relationsTo DocumentRelation[] @relation("DocumentRelationTo")
  content DocumentContent?
  importsFrom ImportBatch[] @relation("ImportSource")
  importsInto ImportBatch[] @relation("ImportResult")
  @@index([workspaceId, deletedAt, id])
  @@index([workspaceId, deletedAt, updatedAt, id])
  @@index([workspaceId, externalFileId])
  @@index([ownerMemberId])
}
model DocumentGrant {
  id String @id @default(cuid())
  workspaceId String
  documentId String
  memberId String
  role DocumentGrantRole
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@unique([documentId, memberId])
  @@index([workspaceId, memberId])
}
model DocumentRoomLink {
  id String @id @default(cuid())
  workspaceId String
  documentId String
  roomId String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@unique([documentId, roomId])
  @@index([workspaceId, roomId])
}
model DocumentRelation {
  id String @id @default(cuid())
  workspaceId String
  fromId String
  toId String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from Document @relation("DocumentRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to Document @relation("DocumentRelationTo", fields: [toId], references: [id], onDelete: Cascade)
  @@unique([fromId, toId])
  @@index([workspaceId, toId])
}

// ─── Canonical imports (doc/09 §3, doc/10 §7A) ───────────────────────────────
// "Import as contacts" — distinct from an ordinary spreadsheet import, which only
// creates a native grid document and never touches CRM records. A batch reads a
// table (pasted CSV or an imported sheet), maps columns to fields, previews a
// proposal per row through the one matcher, takes human review of ambiguous rows,
// then commits in resumable chunks. Raw row values are PII: pruned after
// IMPORT_ROW_RETENTION_DAYS (D12); outcomes and provenance stay.

enum ImportKind {
  contacts
  inventory
}

enum ImportStatus {
  previewed
  committing
  completed
  cancelled
}

// What the preview proposes for a row.
enum ImportProposal {
  create
  match // exactly one existing contact (external id, or one personal email holder)
  review // ambiguous or shared-address match: a person decides
  duplicate // repeats an earlier row of the same file
  invalid
}

enum ImportResolution {
  create
  use
  skip
}

enum ImportOutcome {
  created
  matched
  skipped
}

model ImportBatch {
  id               String       @id @default(cuid())
  workspaceId      String
  kind             ImportKind
  status           ImportStatus @default(previewed)
  // Source: an imported sheet document, or pasted/uploaded CSV text
  sourceDocumentId String?
  filename         String?      @db.VarChar(255)
  sourceHash       String       @db.Char(64)
  columns          Json // [{ id, label }]
  mapping          Json // { columnId: field }
  options          Json // { ownerMemberId?, tagIds?, externalProvider? }
  // Derived counts (recomputed on preview/resolve/commit)
  totalRows        Int          @default(0)
  counts           Json // { create, match, review, duplicate, invalid, unresolved, created, matched, skipped }
  resultDocumentId String?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  committedAt      DateTime?
  finishedAt       DateTime?
  rowsPrunedAt     DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDocument Document?       @relation("ImportSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  resultDocument Document?       @relation("ImportResult", fields: [resultDocumentId], references: [id], onDelete: SetNull)
  createdBy      WorkspaceMember @relation(fields: [createdById], references: [id], onDelete: Cascade)
  rows           ImportRow[]
  contacts       Contact[]
  inventoryItems Inventory[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, sourceHash])
  @@index([status, finishedAt])
}

model ImportRow {
  id                String            @id @default(cuid())
  batchId           String
  workspaceId       String
  rowNumber         Int // 1-based data row in the source
  sourceRowId       String?           @db.VarChar(64) // grid row id when the source is a document
  raw               Json? // source cells; null once pruned
  values            Json? // mapped, trimmed field values; null once pruned
  proposal          ImportProposal
  errorCode         String?           @db.VarChar(60)
  candidateIds      Json? // matched record ids the domain matcher found
  proposedContactId String?           @db.VarChar(64) // proposed contact or inventory id
  duplicateOfRow    Int?
  resolution        ImportResolution?
  resolvedContactId String?           @db.VarChar(64)
  outcome           ImportOutcome?
  outcomeNote       String?           @db.VarChar(60)
  contactId         String?
  inventoryId       String?

  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  inventory Inventory?  @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@unique([batchId, rowNumber])
  @@index([batchId, proposal])
  @@index([batchId, outcome])
  @@index([contactId])
  @@index([inventoryId])
}

// ─── Shared native content (doc/10 §10, minimal POC) ─────────────────────────
// The whole content of a native block document, versioned: a save names the
// version it was based on and is refused (409) if someone saved since — clients
// rebase their changed blocks onto the latest and retry, or show a conflict.
// No CRDT, no update log, no checkpoints yet: one row per document.
model DocumentContent {
  documentId        String   @id
  workspaceId       String
  version           Int
  content           Json // [{ id, type: title|paragraph|media, text?, mediaName?, mediaKind? }]
  updatedByMemberId String?
  updatedAt         DateTime @updatedAt

  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy WorkspaceMember? @relation(fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([updatedByMemberId])
}

// Attention queue (doc/11). One row is one member's pointer to one source.
// Not a mail thread. sourceType/sourceId are checked in the service, not by FK,
// so a new domain can raise an item without a new column.
model InboxItem {
  id          String    @id @default(cuid())
  workspaceId String
  memberId    String
  type        String    @db.VarChar(32)
  title       String    @db.VarChar(200)
  summary     String    @db.VarChar(500)
  sourceType  String    @db.VarChar(32)
  sourceId    String    @db.VarChar(64)
  unread      Boolean   @default(true)
  starred     Boolean   @default(false)
  archivedAt  DateTime?
  action      Json
  dedupeKey   String    @db.VarChar(160)
  deliverAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  // Email copy of this notice (null = none wanted): pending | sent | failed | skipped
  emailStatus   String?   @db.VarChar(16)
  emailAttempts Int       @default(0)
  // Earliest next attempt (also the lease of an attempt in progress)
  emailNextAt   DateTime?
  emailedAt     DateTime?
  emailError    String?   @db.VarChar(200)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, dedupeKey])
  @@index([workspaceId, memberId, archivedAt, createdAt])
  @@index([emailStatus, emailNextAt])
}


// Workspace-level attention event (doc/11 revised). One row per business event for
// the whole workspace — not a per-member fan-out. Optional chat presentation points
// at the workspace channel Item. Per-member InboxItem delivery comes later.
model ActivityEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  type          String    @db.VarChar(48)
  title         String    @db.VarChar(200)
  summary       String    @db.VarChar(500)
  sourceType    String    @db.VarChar(32)
  sourceId      String    @db.VarChar(64)
  links         Json?
  dedupeKey     String    @db.VarChar(160)
  itemId        String?
  actorMemberId String?
  deliverAt     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     WorkspaceMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  item      Item?            @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, createdAt])
  @@index([itemId])
  @@index([actorMemberId])
}

// A follow-up addressed to a contact. Recording it is not delivery (doc/11).
model Compose {
  id             String   @id @default(cuid())
  workspaceId    String
  authorMemberId String
  contactId      String
  channel        String   @db.VarChar(16)
  destination    String   @db.VarChar(255)
  subject        String   @db.VarChar(200)
  body           String   @db.Text
  contextType    String   @db.VarChar(32)
  contextId      String   @db.VarChar(64)
  createdAt      DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    WorkspaceMember @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, contactId, createdAt])
  @@index([authorMemberId])
}

// ─── chatbot host + company profile (doc/12) ──────────────────────────────────

// The workspace's one shared, transparent bot channel (doc/12 §3). An ordinary private
// room; workspace members are its members. Rooms stay workspace-free (D5): this row
// is the link.
model WorkspaceChannel {
  workspaceId String   @id
  roomId      String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// A conversation listed under a company (redesign 00-decisions.md D3). Rooms stay
// platform-level (doc/09 D5): a link changes where a room is listed, never who can
// see it. One company per room. The company's channel (WorkspaceChannel) is listed
// with these without a row of its own.
model WorkspaceRoom {
  id               String   @id @default(cuid())
  workspaceId      String
  roomId           String   @unique
  linkedByMemberId String
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

enum WorkflowStatus {
  waiting // on the person's next answer
  working // between an answer and the next question (post-commit work)
  paused  // the person said "Later"
  done
  failed
}

// One server-owned run of a registered workflow for one member (doc/12 §5.1). Steps
// live in code; the run is only the cursor and the draft.
model WorkflowRun {
  id          String         @id @default(cuid())
  workspaceId String
  memberId    String
  userId      String
  roomId      String
  workflowKey String         @db.VarChar(64)
  version     Int
  stepId      String         @db.VarChar(64)
  status      WorkflowStatus
  state       Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember  @relation(fields: [memberId], references: [id])
  answers   WorkflowAnswer[]

  @@index([workspaceId, workflowKey, status])
  @@index([roomId, userId, status])
  @@index([memberId])
}

enum WorkflowAnswerKind {
  choice
  text
}

// Every answer exactly as given — the provenance of each fact (doc/12 §5.3).
model WorkflowAnswer {
  id        String             @id @default(cuid())
  runId     String
  stepId    String             @db.VarChar(64)
  kind      WorkflowAnswerKind
  optionIds Json?
  itemId    String?            // the chat item that carried free text
  raw       String?            @db.Text
  createdAt DateTime           @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([itemId])
}

enum CompanyServiceArea {
  local
  regional
  national
  global
}

enum CompanyVoice {
  professional
  friendly
  bold
  technical
}

enum CompanyFactStatus {
  inferred  // extracted by a model (Slice C)
  stated    // given directly by a person
  corrected // fixed by a person afterwards
}

enum CompanyFactKind {
  offering
  customer
  differentiator
  goal
  term
  avoid
}

// The workspace's durable understanding of the business (doc/12 §5.2). Scalar facts
// are columns; list facts are CompanyFact rows. Documents are derived from it.
model CompanyProfile {
  workspaceId String              @id
  revision    Int                 @default(0)
  name        String?             @db.VarChar(200)
  location    String?             @db.VarChar(200)
  serviceArea CompanyServiceArea?
  purpose     String?             @db.VarChar(1000)
  brandVoice  CompanyVoice?
  // Denormalized primary gallery projection — written only by RecordImageService.
  imageUrl    String?             @db.VarChar(512)
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Where each scalar fact came from.
model CompanyScalarSource {
  workspaceId    String
  field          String            @db.VarChar(32) // name | location | serviceArea | purpose | brandVoice
  status         CompanyFactStatus
  sourceAnswerId String?
  setByMemberId  String
  updatedAt      DateTime          @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  setBy     WorkspaceMember @relation(fields: [setByMemberId], references: [id])

  @@id([workspaceId, field])
  @@index([setByMemberId])
}

model CompanyFact {
  id             String            @id @default(cuid())
  workspaceId    String
  kind           CompanyFactKind
  value          String            @db.VarChar(500)
  status         CompanyFactStatus
  sourceAnswerId String?
  sourceRunId    String?
  setByMemberId  String
  createdAt      DateTime          @default(now())
  supersededAt   DateTime?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  setBy     WorkspaceMember @relation(fields: [setByMemberId], references: [id])

  @@index([workspaceId, kind, supersededAt])
  @@index([setByMemberId])
}

// A snapshot per change, so a document can name the facts it was written from.
model CompanyProfileRevision {
  id                String   @id @default(cuid())
  workspaceId       String
  revision          Int
  snapshot          Json
  actionExecutionId String?
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, revision])
}

// One AI call made by a chatbot workflow (doc/12 §7): extract facts from a typed
// description, or draft a document. Logged whether it succeeded or not; caps and the
// daily spend are counted from here. The model's output is data — workflow code
// decides what to do with it.
enum AssistantCallKind {
  extract
  generate
}

model AssistantCall {
  id               String            @id @default(cuid())
  workspaceId      String
  runId            String?
  kind             AssistantCallKind
  provider         String            @db.VarChar(32)
  model            String?           @db.VarChar(64)
  inputChars       Int
  promptTokens     Int?
  completionTokens Int?
  costUsd          Float?
  latencyMs        Int?
  error            String?           @db.VarChar(160)
  result           Json?
  at               DateTime          @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, at])
  @@index([at])
}

// ─── agent proposals (doc/13 §5) ──────────────────────────────────────────────

enum AgentProposalStatus {
  pending
  applied
  dismissed
  expired // the target changed underneath it, or it timed out
  undone
}

// A typed change the agent (or a person, through the agent) proposes to one record.
// `kind` selects a registered server-side handler; `proposedChange` is data that
// handler validates — never permission to mutate anything else. Chat and the record
// page render this same row.
model AgentProposal {
  id                String              @id @default(cuid())
  workspaceId       String
  kind              String              @db.VarChar(64)
  targetType        String              @db.VarChar(32)
  targetId          String              @db.VarChar(64)
  // The target's version (or revision) the proposal was made against.
  baseVersion       Int
  proposedChange    Json
  // Frozen before/after rows for display, computed by the handler at proposal time.
  diff              Json
  evidence          Json?
  // The chat line that renders it (its placement), if any.
  itemId            String?
  createdByMemberId String
  createdAt         DateTime            @default(now())
  expiresAt         DateTime
  status            AgentProposalStatus @default(pending)
  decidedAt         DateTime?
  decidedByMemberId String?
  // The target version Apply produced; Undo only runs while the target is still there.
  resultVersion     Int?
  undoData          Json?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember @relation("ProposalCreator", fields: [createdByMemberId], references: [id])
  decidedBy WorkspaceMember? @relation("ProposalDecider", fields: [decidedByMemberId], references: [id])
  item      Item?           @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([workspaceId, targetType, targetId, status])
  @@index([itemId])
  @@index([createdByMemberId])
  @@index([decidedByMemberId])
}

// ─── contact briefing (doc/13 D3) ─────────────────────────────────────────────

// The last brief one member saw for one contact. A cache, not a record: it holds the
// structured brief and the evidence it cites, plus a hash of the evidence pack it was
// built from — a different hash now means the brief is stale. Per member, because
// the pack is built with that member's permissions (rooms they can't see stay out).
model ContactBrief {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  memberId    String
  packHash    String   @db.VarChar(64)
  brief       Json
  evidence    Json
  generator   String   @db.VarChar(16) // ai | template
  model       String?  @db.VarChar(64)
  callId      String?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([contactId, memberId])
  @@index([workspaceId])
  @@index([memberId])
}

// ─── communication agents (docs/agents) ───────────────────────────────────────

// How a connection sends. The UI shows two choices: "Send with 8080" (platform) and
// "Use my own email/domain" (every other strategy).
enum EmailConnectionStrategy {
  platform
  smtp
  google
  microsoft
  resend_domain
}

enum EmailConnectionStatus {
  active
  needs_attention // authentication failed; its sends fail until fixed
  disabled
}

// A sender identity (docs/agents/07 decision 1). Agents reference one; nobody else
// ever sees `secret`. Every workspace gets a platform connection at creation.
model EmailConnection {
  id                String                  @id @default(cuid())
  workspaceId       String
  strategy          EmailConnectionStrategy
  status            EmailConnectionStatus   @default(active)
  // = workspaceId while this is the workspace default, else null (one default each).
  defaultFor        String?                 @unique
  displayName       String                  @db.VarChar(120)
  // Null for platform: the platform address comes from the environment.
  fromAddress       String?                 @db.VarChar(255)
  replyTo           String?                 @db.VarChar(255)
  // Encrypted credentials (lib/secrets.ts); null for platform.
  secret            String?                 @db.Text
  lastTestedAt      DateTime?
  lastError         String?                 @db.VarChar(500)
  createdByMemberId String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    Agent[]

  @@index([workspaceId])
}

enum AgentFamily {
  scheduled
  followup
  manual
  team
  social
}

enum AgentStatus {
  draft
  active
  paused
  archived
}

// One user-configured instance of a built-in Agent type (services/agents/registry.ts).
// Configs are bounded data the type validates — never code or expressions.
model Agent {
  id                String      @id @default(cuid())
  workspaceId       String
  typeKey           String      @db.VarChar(64)
  family            AgentFamily
  name              String      @db.VarChar(160)
  status            AgentStatus @default(draft)
  // Null = the workspace default sender, resolved at send time.
  emailConnectionId String?
  recipientConfig   Json
  deliveryConfig    Json
  ruleConfig        Json
  templateKey       String      @db.VarChar(64)
  themeKey          String      @db.VarChar(64)
  createdByMemberId String
  publishedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailConnection EmailConnection? @relation(fields: [emailConnectionId], references: [id], onDelete: SetNull)
  messages        AgentMessage[]
  events          AgentEvent[]

  @@index([workspaceId, status])
  @@index([emailConnectionId])
}

enum AgentMessageStatus {
  empty
  draft
  ready
}

// One piece of content an Agent owns. `content` is email blocks (@project/shared
// emailBlocks), not provider HTML.
model AgentMessage {
  id          String             @id @default(cuid())
  workspaceId String
  agentId     String
  position    Int
  title       String             @db.VarChar(160)
  status      AgentMessageStatus @default(empty)
  subject     String?            @db.VarChar(200)
  content     Json
  // Overrides of the Agent's template/theme.
  templateKey String?            @db.VarChar(64)
  themeKey    String?            @db.VarChar(64)
  // Set when a queued message is consumed by an event.
  usedAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  agent  Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events AgentEvent[]

  @@index([agentId, position])
  @@index([workspaceId])
}

enum AgentEventStatus {
  scheduled
  running
  completed
  failed
  canceled
}

// One concrete past or future action of an Agent — the activity river row.
model AgentEvent {
  id             String           @id @default(cuid())
  workspaceId    String
  agentId        String
  messageId      String?
  status         AgentEventStatus @default(scheduled)
  scheduledFor   DateTime
  // Which occurrence this is (e.g. "2026-11-02T09:00" or "contact:<id>"); one event each.
  occurrenceKey  String           @db.VarChar(120)
  // The job runner's claim; null while idle (waiting for a retry or not yet due).
  leaseUntil     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  // Set once targets are resolved and frozen.
  preparedAt     DateTime?
  targetCount    Int              @default(0)
  successCount   Int              @default(0)
  failureCount   Int              @default(0)
  skippedCount   Int              @default(0)
  failureCode    String?          @db.VarChar(64)
  failureSummary String?          @db.VarChar(500)
  // Type-specific facts known when the event was created (e.g. the contact it is about).
  context        Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  agent      Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  message    AgentMessage?        @relation(fields: [messageId], references: [id], onDelete: SetNull)
  deliveries AgentEventDelivery[]

  @@unique([agentId, occurrenceKey])
  @@index([status, scheduledFor])
  @@index([workspaceId, scheduledFor])
  @@index([messageId])
}

enum AgentDestination {
  email
  internal_chat
}

enum AgentDeliveryStatus {
  pending
  running
  completed
  failed
}

// One destination of an event (doc 06 §5); destinations fail independently.
model AgentEventDelivery {
  id             String              @id @default(cuid())
  workspaceId    String
  eventId        String
  destination    AgentDestination
  status         AgentDeliveryStatus @default(pending)
  // Frozen sender: { connectionId, strategy, from, replyTo }.
  sender         Json?
  targetCount    Int                 @default(0)
  successCount   Int                 @default(0)
  failureCount   Int                 @default(0)
  skippedCount   Int                 @default(0)
  failureSummary String?             @db.VarChar(500)
  startedAt      DateTime?
  completedAt    DateTime?

  event   AgentEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  targets AgentEventTarget[]

  @@unique([eventId, destination])
  @@index([workspaceId])
}

enum AgentTargetStatus {
  pending
  sent
  failed
  skipped
}

// One recipient of one delivery, with its frozen rendered payload.
model AgentEventTarget {
  id                String            @id @default(cuid())
  workspaceId       String
  deliveryId        String
  agentId           String
  contactId         String?
  memberId          String?
  address           String            @db.VarChar(255)
  // Type-defined duplicate key; `dedupeSlot` holds "<agentId>:<key>" while the target
  // is pending or sent, so a second live target for it cannot exist.
  dedupeKey         String?           @db.VarChar(160)
  dedupeSlot        String?           @unique @db.VarChar(191)
  status            AgentTargetStatus @default(pending)
  subject           String            @db.VarChar(255)
  html              String            @db.MediumText
  text              String            @db.MediumText
  // Destination-specific frozen extras (company chat: the post's links).
  payload           Json?
  attempts          Int               @default(0)
  nextAttemptAt     DateTime?
  providerMessageId String?           @db.VarChar(255)
  failureCode       String?           @db.VarChar(64)
  failureMessage    String?           @db.VarChar(500)
  sentAt            DateTime?
  createdAt         DateTime          @default(now())

  delivery     AgentEventDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  sendAttempts AgentSendAttempt[]

  @@index([deliveryId, status])
  @@index([agentId, dedupeKey])
  @@index([workspaceId])
}

enum AgentAttemptOutcome {
  sent
  transient // retried while attempts remain
  permanent
  auth
}

// Every provider call for a target — retries are visible (docs/agents/07 decision 7).
model AgentSendAttempt {
  id                String              @id @default(cuid())
  targetId          String
  number            Int
  outcome           AgentAttemptOutcome
  code              String?             @db.VarChar(64)
  message           String?             @db.VarChar(500)
  providerMessageId String?             @db.VarChar(255)
  at                DateTime            @default(now())

  target AgentEventTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([targetId, number])
}

// What the dev/test provider "sent" (EMAIL_TRANSPORT=dev). Never used in production.
model DevOutboxEmail {
  id             String   @id @default(cuid())
  workspaceId    String?
  connectionId   String?
  from           String   @db.VarChar(320)
  replyTo        String?  @db.VarChar(255)
  to             String   @db.VarChar(255)
  subject        String   @db.VarChar(255)
  html           String   @db.MediumText
  text           String   @db.MediumText
  headers        Json?
  // The sender's idempotency key: the same key is stored once.
  idempotencyKey String?  @unique @db.VarChar(191)
  createdAt      DateTime @default(now())

  @@index([to, createdAt])
}

// Durable facts used to produce contact-triggered Agent runs. Written with the business change.
model AgentBusinessEvent {
  id String @id @default(cuid())
  workspaceId String
  contactId String
  kind String @db.VarChar(40)
  sourceKey String @db.VarChar(160)
  occurredAt DateTime
  facts Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, sourceKey])
  @@index([workspaceId, contactId, kind, occurredAt])
}

// Workspace-wide customer-email exclusion; shared email addresses share an opt-out.
model AgentEmailSuppression {
  id String @id @default(cuid())
  workspaceId String
  address String @db.VarChar(254)
  reason String @db.VarChar(40)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, address])
}

// Only the digest is stored. Old message links remain valid after contact edits/deletion.
model AgentUnsubscribeToken {
  tokenHash String @id @db.Char(64)
  workspaceId String
  address String @db.VarChar(254)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, address])
}

// ─── Jira-style work management & sprint tracking ──────────────────────────────
model Sprint {
  id          String     @id @default(cuid())
  workspaceId String
  name        String     @db.VarChar(120)
  goal        String?    @db.VarChar(500)
  startDate   DateTime?
  endDate     DateTime?
  status      String     @default("active") @db.VarChar(32)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     WorkTask[]

  @@index([workspaceId, status])
}

// A task on the workspace's Calendar and Boards (one shared list for every view).
// `rank` orders cards inside a status column (fractional; renumbered when gaps
// run out). Deleting is soft so the board can offer Undo.
model WorkTask {
  links             TaskLink[]
  id                String           @id @default(cuid())
  workspaceId       String
  taskKey           String           @db.VarChar(32)
  taskNumber        Int
  title             String           @db.VarChar(255)
  description       String?          @db.Text
  status            String           @default("open") @db.VarChar(32)
  issueType         String           @default("task") @db.VarChar(32)
  area              String?          @db.VarChar(64)
  priority          String           @default("medium") @db.VarChar(32)
  storyPoints       Int?
  scheduledDate     String?          @db.VarChar(10)
  scheduledTime     String?          @db.VarChar(5)
  dueDate           DateTime?
  assigneeMemberId  String?
  createdByMemberId String?
  sprintId          String?
  source            String?          @db.VarChar(64)
  rank              Float            @default(0)
  version           Int              @default(1)
  resolvedAt        DateTime?
  // Blocked is task state (not a column): when, why and by whom.
  blockedAt         DateTime?
  blockedReason     String?          @db.VarChar(280)
  blockedByMemberId String?
  // A subtask's parent (one level: a subtask has no subtasks of its own).
  parentTaskId      String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint    Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee  WorkspaceMember? @relation("WorkTaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)
  createdBy WorkspaceMember? @relation("WorkTaskCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  blockedBy WorkspaceMember? @relation("WorkTaskBlocker", fields: [blockedByMemberId], references: [id], onDelete: SetNull)
  parent    WorkTask?        @relation("WorkTaskParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks  WorkTask[]       @relation("WorkTaskParent")
  comments  WorkComment[]
  activities Activity[]
  checklist WorkChecklistItem[]
  workLogs  WorkLog[]

  @@unique([workspaceId, taskKey])
  @@index([workspaceId, status, rank])
  @@index([workspaceId, scheduledDate])
  @@index([workspaceId, sprintId])
  @@index([workspaceId, parentTaskId])
}

// A checklist line inside a task: small steps that don't need their own owner or
// status (those are subtasks). `position` orders them (fractional).
model WorkChecklistItem {
  id             String    @id @default(cuid())
  workspaceId    String
  taskId         String
  text           String    @db.VarChar(500)
  done           Boolean   @default(false)
  position       Float     @default(0)
  doneAt         DateTime?
  doneByMemberId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  task   WorkTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  doneBy WorkspaceMember? @relation("ChecklistDoneBy", fields: [doneByMemberId], references: [id], onDelete: SetNull)

  @@index([taskId, position])
}

model WorkComment {
  id             String           @id @default(cuid())
  taskId         String
  authorMemberId String?
  authorName     String           @db.VarChar(120)
  text           String           @db.Text
  createdAt      DateTime         @default(now())

  task   WorkTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author WorkspaceMember? @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// "Log work" on the calendar: what got done, by whom (member; null = the whole
// team), optionally against a task. authorMember = who wrote the entry.
model WorkLog {
  id             String           @id @default(cuid())
  workspaceId    String
  taskId         String?
  taskKey        String?          @db.VarChar(32)
  summary        String           @db.VarChar(500)
  category       String           @default("work") @db.VarChar(32)
  day            String           @db.VarChar(10)
  time           String?          @db.VarChar(5)
  memberId       String?
  authorMemberId String?
  authorName     String?          @db.VarChar(120)
  hoursSpent     Float?
  createdAt      DateTime         @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      WorkTask?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  member    WorkspaceMember? @relation("WorkLogMember", fields: [memberId], references: [id], onDelete: SetNull)
  author    WorkspaceMember? @relation("WorkLogAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, day])
  @@index([taskId])
}

// A workspace's task statuses (board columns). Keys never change once created;
// code reads `category` (todo/doing/done), never a key. Seeded with the defaults
// (packages/shared taskWorkflow) on first use.
model TaskStatusDef {
  id          String   @id @default(cuid())
  workspaceId String
  key         String   @db.VarChar(32)
  label       String   @db.VarChar(40)
  category    String   @db.VarChar(16)
  position    Int
  handoff     Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

// Board settings per workspace. wipLimits: { [status]: max cards } (soft limits).
model TaskBoardSettings {
  workspaceId String   @id
  wipLimits   Json
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// A member's saved Calendar view: a name and the view + filters as a URL query
// (view, who, type, area, priority, attention, q). Personal; at most 20 per member.
model TaskView {
  id          String   @id @default(cuid())
  workspaceId String
  memberId    String
  name        String   @db.VarChar(60)
  query       String   @db.VarChar(1000)
  position    Float    @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([workspaceId, memberId, position])
}

// A task related to a contact or a conversation (room, optionally one item in it).
// Linking is recorded on the task's history (and the contact's timeline).
model TaskLink {
  id          String   @id @default(cuid())
  workspaceId String
  taskId      String
  contactId   String?
  roomId      String?
  itemId      String?
  pairKey     String   @db.VarChar(100) // "<taskId>|contact:<id>" / "|room:<id>" / "|item:<id>"
  linkedById  String?
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      WorkTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contact   Contact?         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  room      Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  linkedBy  WorkspaceMember? @relation(fields: [linkedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, pairKey])
  @@index([taskId])
  @@index([contactId])
  @@index([roomId])
  @@index([linkedById])
}
